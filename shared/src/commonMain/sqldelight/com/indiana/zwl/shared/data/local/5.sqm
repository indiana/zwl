CREATE TABLE IF NOT EXISTS WaterSource (
    id INTEGER NOT NULL DEFAULT 0 PRIMARY KEY AUTOINCREMENT,
    osmId TEXT NOT NULL,
    type TEXT NOT NULL,
    name TEXT NOT NULL,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    source TEXT NOT NULL,
    drinkingWater TEXT NOT NULL,
    verified INTEGER NOT NULL DEFAULT 0,
    depthMeters REAL,
    notes TEXT
);

CREATE UNIQUE INDEX IF NOT EXISTS WaterSource_osmId ON WaterSource(osmId);

CREATE TABLE IF NOT EXISTS WaterDataState (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    dataVersion INTEGER NOT NULL,
    lastCheckedAt INTEGER NOT NULL,
    sha256 TEXT,
    count INTEGER NOT NULL DEFAULT 0
);
