CREATE TABLE IF NOT EXISTS WaterSource (
    id INTEGER NOT NULL DEFAULT 0 PRIMARY KEY AUTOINCREMENT,
    osmId TEXT NOT NULL,
    type TEXT NOT NULL,
    name TEXT NOT NULL,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    source TEXT NOT NULL,
    drinkingWater TEXT NOT NULL,
    verified INTEGER NOT NULL DEFAULT 0,
    depthMeters REAL,
    notes TEXT
);

CREATE UNIQUE INDEX IF NOT EXISTS WaterSource_osmId ON WaterSource(osmId);

selectAll:
SELECT * FROM WaterSource;

count:
SELECT count(*) FROM WaterSource;

insertAll:
INSERT OR REPLACE INTO WaterSource(osmId, type, name, latitude, longitude, source, drinkingWater, verified, depthMeters, notes)
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAll:
DELETE FROM WaterSource;
